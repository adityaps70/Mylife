{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "self-streak",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/", "/app", "/app/", "/google*.html"] },
  "ai": { "binding": "AI" },
  "d1_databases": [{ "binding": "DB", "database_name": "self-streak", "database_id": "f98709f8-60b2-4740-9623-230f2877f9a7" }],
  // Custom domain (selfstreak.com is on Cloudflare DNS). Deploy only after the zone is active.
  "workers_dev": true,
  "routes": [
    { "pattern": "selfstreak.com", "custom_domain": true },
    { "pattern": "www.selfstreak.com", "custom_domain": true }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "DAILY_AI_LIMIT": "100",
    "AUTOPAY_LIVE": "1",
    // Weekly recap + renewal reminder emails. "0" = push only (Resend free tier: 100/day). Set "1" once there are paying customers.
    "EMAIL_UPDATES": "0",
    "AUTOPAY_TESTERS": "igforgamers@gmail.com",
    "TRIAL_DAYS": "7",
    "PRICE_INR": "199",
    "VAPID_PUBLIC_KEY": "BD-VBa02pcA2wwTGLv16rP9666MiyTnAvwKevoYVnuqi6KVBhISN42hqMhiSpUORRf1Dgghcs6q2UUaISaSKhUk",
    "VAPID_SUBJECT": "mailto:support@selfstreak.app",
    "CASHFREE_ENV": "production",
    "GOOGLE_CLIENT_ID": "344542883582-tj51ccld17o6u84j20no54hdcfbs9rt3.apps.googleusercontent.com"
  }
  // Secrets (set with wrangler secret put): ANTHROPIC_API_KEY, VAPID_PRIVATE_JWK, CASHFREE_APP_ID, CASHFREE_SECRET_KEY
}
